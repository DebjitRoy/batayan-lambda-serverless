{
  "name": "batayan-serverless",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless AWS Lambda APIs for the Batayan Blog application.",
  "scripts": {
    "build": "serverless package",
    "dev": "serverless offline",
    "dev:local": "node scripts/dev-local.mjs",
    "deploy": "serverless deploy",
    "remove": "serverless remove",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "recovery:preserve": "node scripts/preserve-backups.mjs",
    "db:local:setup": "node scripts/local-tables.mjs",
    "db:local:start": "node scripts/start-dynamodb.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:parity": "node scripts/test-parity.mjs",
    "test:acceptance": "node scripts/run-phase3.mjs local",
    "test:images": "node scripts/run-phase3.mjs images",
    "test:aws": "node scripts/run-phase3.mjs aws",
    "test:phase3": "node scripts/test-phase3.mjs",
    "test:release-gates": "node scripts/release-gates.mjs",
    "migration:validate": "node scripts/run-migration.mjs validate",
    "migration:import": "node scripts/run-migration.mjs import",
    "migration:verify": "node scripts/run-migration.mjs verify",
    "migration:rehearse": "node scripts/run-migration.mjs rehearse"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/client-lambda": "3.1061.0",
    "@aws-sdk/client-s3": "3.1061.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1061.0",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3",
    "openai": "^5.0.0",
    "snowball-stemmers": "0.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-sts": "3.1157.0",
    "@types/aws-lambda": "8.10.161",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "esbuild": "0.28.0",
    "fflate": "0.8.3",
    "mongodb": "7.7.0",
    "mongodb-memory-server": "11.3.0",
    "serverless": "4.37.0",
    "serverless-offline": "14.7.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
