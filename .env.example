JWT_SECRET=replace-with-a-long-random-secret
S3_BUCKET=batayan-blog-images
S3_PUBLIC_BASE_URL=https://batayan-blog-images.s3.amazonaws.com
AWS_REGION=us-east-1

# Local development only; do not set DYNAMODB_ENDPOINT in AWS deployments.
DYNAMODB_ENDPOINT=http://localhost:8000
LAMBDA_ENDPOINT=http://localhost:4002
POSTS_TABLE=batayan-serverless-dev-posts
COMMENTS_TABLE=batayan-serverless-dev-comments
USERS_TABLE=batayan-serverless-dev-users
SERIES_TABLE=batayan-serverless-dev-series
JOBS_TABLE=batayan-serverless-dev-jobs
OPENAI_API_KEY=
# Optional; creates account-wide $1, $2, $3, $4, $5 spend alerts in prod only.
BUDGET_ALERT_EMAIL=
